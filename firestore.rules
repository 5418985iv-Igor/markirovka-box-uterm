rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'login', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'login', 'displayName', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.login is string && data.login.size() >= 2 && data.login.size() <= 64
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidAssemblyBox(data) {
      return data.keys().hasAll([
          'id', 'boxCode', 'boxNumber', 'operatorId', 'operatorLogin',
          'status', 'itemsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'boxCode', 'boxNumber', 'operatorId', 'operatorLogin',
          'status', 'itemsCount', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && isValidId(data.id)
        && data.boxCode is string && data.boxCode.size() >= 1 && data.boxCode.size() <= 256
        && data.boxNumber is string && data.boxNumber.size() >= 1 && data.boxNumber.size() <= 128
        && isValidId(data.operatorId)
        && data.operatorId == request.auth.uid
        && data.operatorLogin is string && data.operatorLogin.size() >= 1 && data.operatorLogin.size() <= 64
        && data.status in ['assembling', 'completed']
        && data.itemsCount is int && data.itemsCount >= 0 && data.itemsCount <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          (data.status == 'assembling' && !('completedAt' in data)) ||
          (data.status == 'completed' && 'completedAt' in data && data.completedAt is timestamp)
        );
    }

    function isValidScannedItem(data) {
      return data.keys().hasAll([
          'id', 'boxId', 'operatorId', 'rawCode', 'gtin', 'serial', 'cryptoTail', 'format', 'scannedAt'
        ])
        && data.keys().hasOnly([
          'id', 'boxId', 'operatorId', 'rawCode', 'gtin', 'serial', 'cryptoTail', 'format', 'scannedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.boxId)
        && isValidId(data.operatorId)
        && data.operatorId == request.auth.uid
        && data.rawCode is string && data.rawCode.size() >= 1 && data.rawCode.size() <= 512
        && data.gtin is string && data.gtin.size() <= 32
        && data.serial is string && data.serial.size() <= 128
        && data.cryptoTail is string && data.cryptoTail.size() <= 128
        && data.format in ['DATA_MATRIX', 'QR_CODE', 'MANUAL']
        && data.scannedAt is timestamp;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['login', 'displayName']);
      allow delete: if false;
    }

    // --- Collection: /boxes/{boxId} ---
    match /boxes/{boxId} {
      allow get: if isSignedIn()
        && isValidId(boxId)
        && resource.data.operatorId == request.auth.uid;

      allow list: if isSignedIn()
        && resource.data.operatorId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(boxId)
        && isValidAssemblyBox(incoming())
        && incoming().id == boxId
        && incoming().status == 'assembling'
        && incoming().itemsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(boxId)
        && isValidAssemblyBox(incoming())
        && existing().operatorId == request.auth.uid
        && existing().status == 'assembling'
        && incoming().id == existing().id
        && incoming().operatorId == existing().operatorId
        && incoming().operatorLogin == existing().operatorLogin
        && incoming().boxCode == existing().boxCode
        && incoming().boxNumber == existing().boxNumber
        && incoming().createdAt == existing().createdAt
        && (
          (
            incoming().status == 'assembling'
            && incoming().diff(existing()).affectedKeys().hasOnly(['itemsCount', 'updatedAt'])
            && incoming().updatedAt == request.time
            && (
              incoming().itemsCount == existing().itemsCount + 1 ||
              incoming().itemsCount == existing().itemsCount - 1
            )
          ) ||
          (
            incoming().status == 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
            && incoming().updatedAt == request.time
            && incoming().completedAt == request.time
            && incoming().itemsCount == existing().itemsCount
          )
        );

      allow delete: if isSignedIn()
        && isValidId(boxId)
        && existing().operatorId == request.auth.uid
        && existing().status == 'assembling'
        && existing().itemsCount == 0;

      // --- Subcollection: /boxes/{boxId}/items/{itemId} ---
      match /items/{itemId} {
        allow get: if isSignedIn()
          && isValidId(boxId)
          && isValidId(itemId)
          && resource.data.operatorId == request.auth.uid;

        allow list: if isSignedIn()
          && resource.data.operatorId == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(boxId)
          && isValidId(itemId)
          && isValidScannedItem(incoming())
          && incoming().id == itemId
          && incoming().boxId == boxId
          && incoming().scannedAt == request.time
          && exists(/databases/$(database)/documents/boxes/$(boxId))
          && get(/databases/$(database)/documents/boxes/$(boxId)).data.operatorId == request.auth.uid
          && get(/databases/$(database)/documents/boxes/$(boxId)).data.status == 'assembling'
          && incoming().rawCode != get(/databases/$(database)/documents/boxes/$(boxId)).data.boxCode
          && incoming().rawCode != get(/databases/$(database)/documents/boxes/$(boxId)).data.boxNumber
          && getAfter(/databases/$(database)/documents/boxes/$(boxId)).data.itemsCount
             == get(/databases/$(database)/documents/boxes/$(boxId)).data.itemsCount + 1;

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidId(boxId)
          && isValidId(itemId)
          && existing().operatorId == request.auth.uid
          && exists(/databases/$(database)/documents/boxes/$(boxId))
          && get(/databases/$(database)/documents/boxes/$(boxId)).data.operatorId == request.auth.uid
          && get(/databases/$(database)/documents/boxes/$(boxId)).data.status == 'assembling'
          && getAfter(/databases/$(database)/documents/boxes/$(boxId)).data.itemsCount
             == get(/databases/$(database)/documents/boxes/$(boxId)).data.itemsCount - 1;
      }
    }
  }
}
